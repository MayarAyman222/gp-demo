generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Icon {
  id         Int       @id @default(autoincrement())
  title      String       
  expression String
  createdAt  DateTime  @default(now())
  iconName   String    @default("")
  category   String
  subIcons   SubIcon[]
}

model SubIcon {
  id         Int      @id @default(autoincrement())
  title      String
  expression String
  imageUrl   String
  iconId     Int
  createdAt  DateTime @default(now())
  icon       Icon     @relation(fields: [iconId], references: [id])

 //([title, iconId])
}
